*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:'Poppins',sans-serif;
    background:#f5f7fb;
    color:#1f2937;

}

nav{

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:25px 8%;

    background:white;

    box-shadow:0 2px 10px rgba(0,0,0,.05);

    position:sticky;
    top:0;

}

nav ul{

display:flex;
gap:30px;

list-style:none;

}

nav a{

text-decoration:none;
color:#374151;
font-weight:500;

}

.logo{

font-size:24px;
font-weight:700;
color:#2563eb;

}

.hero{

display:flex;

justify-content:space-between;

align-items:center;

padding:80px 8%;

gap:60px;

}

.hero h1{

font-size:60px;

margin-bottom:10px;

}

.hero h2{

font-size:28px;

color:#2563eb;

margin-bottom:25px;

}

.hero p{

font-size:20px;

line-height:1.7;

margin-bottom:35px;

}

.hero-image img{

width:320px;

border-radius:50%;

box-shadow:0 20px 50px rgba(37,99,235,.2);

}

.buttons{

display:flex;

gap:20px;

}

.btn-primary{

background:#2563eb;

color:white;

padding:15px 28px;

border-radius:10px;

text-decoration:none;

}

.btn-secondary{

border:2px solid #2563eb;

padding:15px 28px;

border-radius:10px;

text-decoration:none;

color:#2563eb;

}

section{

padding:80px 8%;

}

section h2{

font-size:40px;

margin-bottom:40px;

}

.cards{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:25px;

}

.card{

background:white;

padding:30px;

border-radius:15px;

box-shadow:0 10px 30px rgba(0,0,0,.05);

transition:.3s;

}

.card:hover{

transform:translateY(-8px);

}

footer{

background:#1f2937;

color:white;

text-align:center;

padding:50px;

}
